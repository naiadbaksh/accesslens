{
  "name": "accesslens",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @accesslens/api",
    "dev:web": "npm run dev -w @accesslens/web",
    "test": "npm test -w @accesslens/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
